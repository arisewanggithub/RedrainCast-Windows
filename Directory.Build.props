<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version Condition="'$(Version)' == ''">0.1.5</Version>
    <WindowsArchitecture Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(Platform)' == 'x64'">x64</WindowsArchitecture>
    <WindowsArchitecture Condition="'$(WindowsArchitecture)' == ''">arm64</WindowsArchitecture>
    <WindowsRuntimeIdentifier>win-$(WindowsArchitecture)</WindowsRuntimeIdentifier>
    <ReceiverArchitecture>$(WindowsArchitecture)</ReceiverArchitecture>
    <ReceiverRuntimeIdentifier>$(WindowsRuntimeIdentifier)</ReceiverRuntimeIdentifier>
  </PropertyGroup>
</Project>
