<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(WindowsRuntimeIdentifier)</RuntimeIdentifier>
    <PlatformTarget>$(WindowsArchitecture)</PlatformTarget>
    <Platforms>ARM64;x64</Platforms>
    <ApplicationManifest>..\RedrainCast.App\app.manifest</ApplicationManifest>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Product>RedrainCast</Product>
    <Description>Isolated RedrainCast hardware capture worker.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScrcpySend.Media\ScrcpySend.Media.csproj"/>
  </ItemGroup>
  <Target Name="GetCaptureWorkerFiles" DependsOnTargets="Build" Returns="@(_CaptureWorkerRuntimeFiles)">
    <Error Condition="'$(TargetDir)' == '' Or !Exists('$(TargetDir)RedrainCast.CaptureWorker.exe')"
           Text="The capture worker runtime output directory is unavailable."/>
    <ItemGroup>
      <_CaptureWorkerRuntimeFiles Include="$(TargetDir)**\*" Exclude="$(TargetDir)**\*.pdb"/>
    </ItemGroup>
  </Target>
</Project>
