<Window
    x:Class="RedrainCast.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:RedrainCast.Core"
    xmlns:local="using:RedrainCast.App">
    <Grid x:Name="WindowRoot" PreviewKeyDown="Root_KeyDown" SizeChanged="WindowRoot_SizeChanged"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="ReadyBackground" Color="#E3F5E9"/>
                        <SolidColorBrush x:Key="ReadyForeground" Color="#146C36"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="ReadyBackground" Color="#193C29"/>
                        <SolidColorBrush x:Key="ReadyForeground" Color="#8CE8AB"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="ReadyBackground" Color="{ThemeResource SystemColorWindowColor}"/>
                        <SolidColorBrush x:Key="ReadyForeground" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <ContentControl x:Name="PlayerInput" IsTabStop="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" FlowDirection="LeftToRight">
            <Border Background="Black"><SwapChainPanel x:Name="VideoSurface"/></Border>
        </ContentControl>
        <Border x:Name="PlaybackStatsOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="8"
                Background="#E610151B" CornerRadius="6">
            <StackPanel x:Name="PlaybackStatsPanel" IsHitTestVisible="False"/>
        </Border>
        <Grid x:Name="HomePage"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <ScrollViewer x:Name="HomeScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Stretch" IsTabStop="False">
            <Grid RowSpacing="16" Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="RedrainCast" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding HomeTagline, Source={StaticResource Strings}}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Button x:Name="SettingsButton" Grid.Column="1" Click="Settings_Click" VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding Settings, Source={StaticResource Strings}}" ToolTipService.ToolTip="{Binding Settings, Source={StaticResource Strings}}">
                    <FontIcon Glyph="&#xE713;"/>
                </Button>
            </Grid>
            <InfoBar x:Name="Problem" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Error"/>
                <Grid x:Name="Cards" Grid.Row="2" ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="SendCard" Padding="20" CornerRadius="12" VerticalAlignment="Top"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="18">
                            <TextBlock Text="{Binding SendScreen, Source={StaticResource Strings}}" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SendHint, Source={StaticResource Strings}}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button x:Name="ChooseSource" Click="ChooseSource_Click" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" ToolTipService.ToolTip="{Binding ChooseSourceHelp, Source={StaticResource Strings}}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding ShareSource, Source={StaticResource Strings}}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SourceLabel" Text="{Binding ChooseSource, Source={StaticResource Strings}}" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding NearbyReceivers, Source={StaticResource Strings}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding AutoUpdating, Source={StaticResource Strings}}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                            <ItemsControl x:Name="ReceiverList" HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:ReceiverRow">
                                        <Border Padding="12" Margin="0,0,0,10" CornerRadius="8" BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{x:Bind DisplayAddress}" FontFamily="Consolas" TextWrapping="Wrap" FlowDirection="LeftToRight"/>
                                                    <TextBlock Text="{x:Bind Status}" FontSize="13" FontWeight="SemiBold"
                                                               AutomationProperties.LiveSetting="Polite"/>
                                                    <TextBlock Text="{x:Bind Parameters}" FontSize="12" TextWrapping="Wrap" FlowDirection="LeftToRight"
                                                               Visibility="{x:Bind local:MainWindow.OptionalTextVisibility(Parameters)}"/>
                                                    <TextBlock Text="{x:Bind Encoder}" FontSize="12" TextWrapping="Wrap" FlowDirection="LeftToRight"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Visibility="{x:Bind local:MainWindow.OptionalTextVisibility(Encoder)}"/>
                                                    <TextBlock Text="{x:Bind Notice}" FontSize="12" TextWrapping="Wrap"
                                                               Visibility="{x:Bind local:MainWindow.OptionalTextVisibility(Notice)}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{x:Bind ActionLabel}" Tag="{x:Bind}" Click="DeviceAction_Click"
                                                        IsEnabled="{x:Bind CanAct}" VerticalAlignment="Center"
                                                        AutomationProperties.Name="{x:Bind ActionHelp}"
                                                        Style="{StaticResource AccentButtonStyle}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="DiscoveryStatus" Text="{Binding LookingForReceivers, Source={StaticResource Strings}}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button x:Name="ManualConnect" Content="{Binding ManualConnect, Source={StaticResource Strings}}" Click="ManualConnect_Click"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ReceiveCard" Grid.Column="1" Padding="20" CornerRadius="12" VerticalAlignment="Top"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="18">
                            <TextBlock Text="{Binding ReceiveScreen, Source={StaticResource Strings}}" FontSize="24" FontWeight="SemiBold"/>
                            <Border x:Name="ReadinessBanner" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <Grid>
                                <Border x:Name="ReadyTint" CornerRadius="8" Background="{ThemeResource ReadyBackground}" Visibility="Collapsed"/>
                                <StackPanel Spacing="6" Padding="18">
                                    <TextBlock x:Name="ReadinessTitle" Text="{Binding Starting, Source={StaticResource Strings}}" FontSize="30" FontWeight="Bold"
                                               AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock x:Name="ReadinessDetail" Text="{Binding OpeningListener, Source={StaticResource Strings}}" TextWrapping="Wrap"/>
                                </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="DeviceName" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ConnectThisPC, Source={StaticResource Strings}}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AddressHint" Text="{Binding AddressHint, Source={StaticResource Strings}}" TextWrapping="Wrap"/>
                            <ItemsControl x:Name="AddressList" HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12" Margin="0,0,0,8" CornerRadius="8" BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Adapter}" FontSize="12" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding DisplayAddress}" FontFamily="Consolas" FontSize="18"
                                                               IsTextSelectionEnabled="True" TextWrapping="Wrap" FlowDirection="LeftToRight"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Tag="{Binding CanonicalAddress}" Click="CopyAddress_Click"
                                                        VerticalAlignment="Center" AutomationProperties.Name="{Binding CopyAddress, Source={StaticResource Strings}}"
                                                        ToolTipService.ToolTip="{Binding CopyAddressHelp, Source={StaticResource Strings}}">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="16"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="AddressFeedback" TextWrapping="Wrap" FontSize="12"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="{Binding IncomingHint, Source={StaticResource Strings}}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding TrustedNetworkHint, Source={StaticResource Strings}}"
                                       FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="VersionText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <HyperlinkButton x:Name="ConnectionHelp" Grid.Column="1" Content="{Binding ConnectionHelp, Source={StaticResource Strings}}" Click="Help_Click"/>
            </Grid>
            </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
